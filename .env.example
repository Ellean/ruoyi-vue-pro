# yudao-server 运行期环境变量模板
#
# 两个用途，同一份模板：
#   本机 compose   cp .env.example .env && chmod 600 .env && $EDITOR .env
#   部署           逐项填真值后整份贴进 GitHub Environment secret APP_ENV
#                  （main / test / dev 各一份），deploy job 会把它渲染成部署机上的 .env。
#                  部署机上那份是产物，不要手改。
#
# 仓库里只保留这一份模板，真值永不入库。
# 规范与判据见 docs/本地开发密钥存放规范.md（§4 生产运行、§6 配置项全清单）；
# 部署拓扑、校验规则与排错见 docs/部署.md。
#
# 不需要覆盖默认值的键请注释或删除；KEY= 表示明确传入空字符串，不会回退到默认值。
# 密钥建议使用单引号引用，避免 $ 插值和空格后的 # 注释改变原值；只支持单行 KEY=VALUE。
#
# 变量名与 application-prod.yaml / application.yaml 的环境占位符对应；改真值后重新部署即可。


######################################################################
# 一、必须提供 —— 缺了应用起不来
######################################################################

# --- MySQL 主库：宿主机安装，每环境单独建库、建应用账号 ---
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-vue-pro
MASTER_DATASOURCE_USERNAME=
MASTER_DATASOURCE_PASSWORD=

# 完整 JDBC URL 覆盖 MYSQL_HOST/PORT/DATABASE 拼接结果，不替代用户名和密码。
# MASTER_DATASOURCE_URL=jdbc:mysql://host:3306/db?useSSL=false&...

# --- Compose 内独立 Redis：每环境一份，不发布宿主机端口 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
# 必填，每环境使用不同随机密码；建议 openssl rand -hex 32 后单引号引用。
REDIS_PASSWORD=

# --- 字段加密密钥：部署校验必填，16/24/32 UTF-8 字节 ---
# 必须匹配现有加密数据；换密钥前先按规范 §7.2 迁移，不能直接生成新值覆盖。
MYBATIS_ENCRYPTOR_PASSWORD=


######################################################################
# 二、按功能开关提供 —— 不用该功能就保留模板状态
######################################################################

# --- 对外地址：XQ_PUBLIC_HOST 被 XQ_RPA_CALLBACK_BASE_URL 的默认值引用 ---
XQ_PUBLIC_HOST=localhost
# XQ_RPA_CALLBACK_BASE_URL=
# 影刀 RPA 回调鉴权。留空则回调不可用（调用期报错，不影响启动）。
XQ_RPA_CALLBACK_TOKEN=

# --- AI 基线：application.yaml（所有 profile）的 spring.ai.openai；XQ AI Key / 模型在库表 ai_api_key ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# --- 阿里云机器翻译 ---
XQ_ALIYUN_MT_AK=
XQ_ALIYUN_MT_SK=
XQ_ALIYUN_MT_ENDPOINT=mt.cn-hangzhou.aliyuncs.com

# --- toapis 用量上报 ---
XQ_TOAPIS_ACCESS_TOKEN=
XQ_TOAPIS_USER_ID=
XQ_TOAPIS_BASE_URL=https://toapis.cn

# --- 上架分表 Excel 根目录 ---
XQ_LISTING_TEMPLATE_ROOT=/data/xq-erp/uploads/gigab2b/listing-templates

######################################################################
# 三、其余 AI 平台密钥 —— application.yaml 声明，默认哨兵串 sk-xxxx
#     不用的平台不用管，yudao-module-ai 只在被调用时才读对应 key
######################################################################

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# BAICHUAN_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# GEMINI_API_KEY=
# GROK_API_KEY=
# HUNYUAN_API_KEY=
# MIDJOURNEY_API_KEY=
# MINIMAX_API_KEY=
# MOONSHOT_API_KEY=
# SILICONFLOW_API_KEY=
# STABILITYAI_API_KEY=
# STEPFUN_API_KEY=
# WEB_SEARCH_API_KEY=
# XINGHUO_API_KEY=
# YIYAN_API_KEY=
# ZHIPU_API_KEY=


######################################################################
# 四、通常不用动 —— 有可用默认值
######################################################################

# 容器内监听端口。compose 的端口映射与镜像的 HEALTHCHECK 都跟着它走，所以改了不会失配；
# 但换环境本来只该动宿主机端口（CI 按分支算好的 HOST_PORT），这一项通常不用碰。
SERVER_PORT=48080
LOG_PATH=/data/logs/yudao-server

# --- 从库：lazy=true，不配就整套跟随主库，不必重复注入 ---
# SLAVE_DATASOURCE_URL=
# SLAVE_DATASOURCE_USERNAME=
# SLAVE_DATASOURCE_PASSWORD=

# --- 消息队列：当前均未启用 ---
# ROCKETMQ_NAME_SERVER=127.0.0.1:9876
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# KAFKA_BOOTSTRAP=127.0.0.1:9092

# --- Spring Boot Admin ---
# 本仓库只依赖 client，没有 admin server（上游 yudao-monitor-admin 未纳入构建），
# 所以这两项目前是空转的。将来接入监控端时由环境注入，不要回落到上游示例的 admin/admin。
# SB_ADMIN_USERNAME=
# SB_ADMIN_PASSWORD=


######################################################################
# 五、可以留空 —— 本项目当前不用微信公众号 / 小程序
######################################################################
# 留空不影响启动：WxMpAutoConfiguration 没有对 app-id 做 @ConditionalOnProperty，
# 空值照样建 bean，失败发生在调用期而非启动期。详见规范 §6.4。

WX_MP_APP_ID=
WX_MP_SECRET=
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
