# yudao-server 运行期环境变量模板
#
# 用途：复制到部署机上改名为 .env，逐项填值。仓库里只保留这一份模板，真值永不入库。
# 规范与判据见 docs/本地开发密钥存放规范.md（§4 生产运行、§6 配置项全清单）。
#
#   cp .env.example .env && chmod 600 .env
#
# 填值原则：只填你要用的档，其余留空或删除。留空的项会回落到 yaml 里的默认值，
# 而默认值是按「漏注入就响亮地失败」设计的 —— 数据库口令默认空串会让 Druid 建连接池
# 即报错退出，不会带着错配置静默跑起来。
#
# 变量名与 application-prod.yaml / application.yaml 里的 ${...} 占位符一一对应，
# 改这里等于改那两份文件，不需要重新构建镜像。


######################################################################
# 一、必须提供 —— 缺了应用起不来
######################################################################

# --- MySQL 主库 ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-vue-pro
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=

# 想自己拼整条 JDBC URL 就填下面这个；它一旦非空，上面四个 MYSQL_* 全部失效。
# MASTER_DATASOURCE_URL=jdbc:mysql://host:3306/db?useSSL=false&...

# --- Redis ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=


######################################################################
# 二、按功能开关提供 —— 不用该功能就留空
######################################################################

# --- 对外地址：被 RPA 回调入口与旧 ERP 根地址共同引用 ---
XQ_PUBLIC_HOST=localhost
XQ_ERP_BASE_URL=
XQ_RPA_CALLBACK_BASE_URL=
# 影刀 RPA 回调鉴权。留空则回调不可用（调用期报错，不影响启动）。
XQ_RPA_CALLBACK_TOKEN=

# --- XQ AI 文案 / 图片 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# --- 阿里云机器翻译 ---
XQ_ALIYUN_MT_AK=
XQ_ALIYUN_MT_SK=
XQ_ALIYUN_MT_ENDPOINT=mt.cn-hangzhou.aliyuncs.com

# --- toapis 用量上报 ---
XQ_TOAPIS_ACCESS_TOKEN=
XQ_TOAPIS_USER_ID=
XQ_TOAPIS_BASE_URL=https://toapis.cn

# --- 上架分表 Excel 根目录 ---
XQ_LISTING_TEMPLATE_ROOT=/data/xq-erp/uploads/gigab2b/listing-templates

# --- 字段加密密钥 ---
# EncryptTypeHandler 用它加密 infra_data_source_config.password。
# yaml 里的默认值是上游开源仓库的公开值，等于没加密，生产必须注入私有密钥。
# 两个约束：不能留空（Assert.notEmpty 会抛），长度须为 16/24/32 字节。
# 换密钥后已加密的存量行解不开，必须同步重加密 —— 迁移四步见规范 §7.2。
MYBATIS_ENCRYPTOR_PASSWORD=


######################################################################
# 三、其余 AI 平台密钥 —— application.yaml 声明，默认哨兵串 sk-xxxx
#     不用的平台不用管，yudao-module-ai 只在被调用时才读对应 key
######################################################################

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
BAICHUAN_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
HUNYUAN_API_KEY=
MIDJOURNEY_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
STABILITYAI_API_KEY=
STEPFUN_API_KEY=
WEB_SEARCH_API_KEY=
XINGHUO_API_KEY=
YIYAN_API_KEY=
ZHIPU_API_KEY=


######################################################################
# 四、通常不用动 —— 有可用默认值
######################################################################

SERVER_PORT=48080
LOG_PATH=/data/logs/yudao-server

# --- 从库：lazy=true，不配就整套跟随主库，不必重复注入 ---
# SLAVE_DATASOURCE_URL=
# SLAVE_DATASOURCE_USERNAME=
# SLAVE_DATASOURCE_PASSWORD=

# --- 消息队列：当前均未启用 ---
# ROCKETMQ_NAME_SERVER=127.0.0.1:9876
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# KAFKA_BOOTSTRAP=127.0.0.1:9092

# --- Spring Boot Admin ---
# 本仓库只依赖 client，没有 admin server（上游 yudao-monitor-admin 未纳入构建），
# 所以这两项目前是空转的。将来接入监控端时由环境注入，不要回落到上游示例的 admin/admin。
# SB_ADMIN_USERNAME=
# SB_ADMIN_PASSWORD=


######################################################################
# 五、可以留空 —— 本项目当前不用微信公众号 / 小程序
######################################################################
# 留空不影响启动：WxMpAutoConfiguration 没有对 app-id 做 @ConditionalOnProperty，
# 空值照样建 bean，失败发生在调用期而非启动期。详见规范 §6.4。

WX_MP_APP_ID=
WX_MP_SECRET=
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
